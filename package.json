{
  "name": "millennium-smartboard-management-system",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "db:seed": "node --import tsx/esm src/db/seed.ts",
    "postbuild": "echo 'Build complete. Database will be initialized on first server start.'",
    "sync": "powershell -ExecutionPolicy Bypass -File auto-sync.ps1",
    "auto-watch": "node auto-watch.js",
    "push": "git add . && git commit -m \"Update code\" && git push origin main"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
